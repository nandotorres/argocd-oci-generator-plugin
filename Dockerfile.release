# syntax=docker/dockerfile:1

# Runtime-only image built by GoReleaser (dockers_v2) as a single multi-platform
# image. GoReleaser builds the binaries and provides them in the build context
# under $TARGETPLATFORM/ (e.g. linux/amd64/plugin). The root Dockerfile builds
# from source and is what CI, `make image`, and the e2e demo use; keep the base
# image digest here in sync with it.
FROM cgr.dev/chainguard/static:latest@sha256:fe55470f22d3259488d9d3739168d8f04da67755f0b69382bc26eda4a7d3d327
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/plugin /usr/local/bin/plugin
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/plugin"]
